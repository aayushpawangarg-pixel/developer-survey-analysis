   "source": [
    "prof_dev = 0\n",
    "hobby_dev = 0\n",
    "learning_dev = 0\n",
    "earlier_dev = 0\n",
    "temp_dev = 0\n",
    "for line in data:\n",
    "    if line[1] == 'I am a developer by profession':\n",
    "        prof_dev += 1\n",
    "    elif line[1] == 'I code primarily as a hobby':\n",
    "        hobby_dev += 1\n",
    "    elif line[1] == 'I am learning to code':\n",
    "        learning_dev += 1\n",
    "    elif line[1] == 'I used to be a developer by profession, but no longer am':\n",
    "        earlier_dev += 1\n",
    "    else:\n",
    "        temp_dev += 1\n",
    "#print(prof_dev, hobby_dev, learning_dev, earlier_dev, temp_dev)\n",
    "print(f\"percentage of developers by profession: {prof_dev / 65437 * 100:.2f}%\")\n",
    "print(f\"percentage of developers by hobby: {hobby_dev / 65437 * 100:.2f}%\")\n",
    "print(f\"percentage of developers learning to code: {learning_dev / 65437 * 100:.2f}%\")\n",
    "print(f\"percentage of developers who used to be professionals: {earlier_dev / 65437 * 100:.2f}%\")\n",
    "print(f\"percentage of people who write code sometimes: {temp_dev / 65437 * 100:.2f}%\")"
   ]
  },
